# Optional locally; set to the final public origin when deploying.
SITE_URL=http://127.0.0.1:3000

# Supabase > Project Settings > API. These are public project identifiers,
# NOT service_role/secret keys. Leaving them unset keeps the invitation usable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Organizer UUID allowlist and optional invitation code are configured only
# in PostgreSQL; see docs/RSVP.md. No service_role key is used by this app.
