# Open the invitation on this exact origin. Set the public HTTPS origin for deployment.
SITE_URL=http://localhost:3000

# Pooled Neon Postgres URL for the pesca_runtime role. Server-only.
DATABASE_URL=

# Managed Better Auth URL for the same Neon branch, including its path.
NEON_AUTH_BASE_URL=

# Server-only. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
